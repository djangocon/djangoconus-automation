ALLOWED_HOSTS=*
DATABASE_URL=postgres://postgres@db/postgres
DJANGO_DEBUG=true
# Email: leave EMAIL_URL unset to print emails to the console (dev default).
# Production example: EMAIL_URL=submission://USER:PASSWORD@smtp.example.com:587
# Implicit TLS (port 465/2465): EMAIL_URL=smtp://USER:PASSWORD@smtp.example.com:2465?ssl=True
# Percent-encode the "@" in a mailbox username, e.g. hello%40mail.defna.org
# EMAIL_URL=
# The From header must match the mailbox EMAIL_URL authenticates as, or Forward
# Email rejects the message with a 550.
# DEFAULT_FROM_EMAIL=DjangoCon US <hello@mail.defna.org>
# SERVER_EMAIL=hello@mail.defna.org
SLACK_OAUTH_TOKEN=
SLACK_CHANNEL_ID=
TITO_SECURITY_TOKEN=
MASTODON_ACCESS_TOKEN=
